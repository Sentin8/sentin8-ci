# sentin8-ci — build artifacts never tracked.

# Local environment (never commit secrets)
/.env

# Scratch output (AGENTS: temp files always under .tmp/)
/.tmp/
/.run/

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/

# Python bytecode (generated by py_compile / local runs)
__pycache__/
*.pyc